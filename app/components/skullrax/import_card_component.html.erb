<div class="card h-100">
  <div class="card-body">
    <h3><%= t('skullrax.dashboard.import.title') %></h3>
    <p class="text-muted"><%= t('skullrax.dashboard.import.instruction') %></p>
    <%= form_with url: import_path, local: true, multipart: true, scope: :import do |f| %>
      <div class="form-group">
        <%= f.label :file, t('skullrax.dashboard.import.label'), class: "sr-only" %>
        <%= f.file_field :file,
              accept: '.csv,.zip',
              class: 'form-control-file',
              required: true %>
      </div>
      <div class="mt-3">
        <%= f.submit t('skullrax.dashboard.import.submit'), class: 'btn btn-primary' %>
      </div>
    <% end %>
  </div>
</div>
