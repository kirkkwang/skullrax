<% provide :page_header do %>
  <%= header_content %>
<% end %>

<% content_for :head do %>
  <%= javascript_include_tag 'skullrax', defer: true %>
<% end %>

<div class="card">
  <div class="card-body">
    <div class="row">
      <div class="col-xl-6 mb-4">
        <%= render Skullrax::ProcessResourcesCardComponent.new %>
      </div>
      <div class="col-xl-6 mb-4">
        <%= render Skullrax::ExportCardComponent.new %>
      </div>
    </div>
    <div class="row">
      <div class="col-12">
        <%= render Skullrax::BatchCreate::CardComponent.new %>
      </div>
    </div>
  </div>
</div>
