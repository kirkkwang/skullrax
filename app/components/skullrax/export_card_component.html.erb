<div class="card h-100">
  <div class="card-body">
    <h3><%= t('skullrax.dashboard.export.title') %></h3>
    <p class="text-muted"><%= t('skullrax.dashboard.export.instruction') %></p>

    <div class="form-group">
      <label for="export_ids" class="sr-only">Work IDs</label>
      <textarea id="export_ids"
                name="ids"
                class="form-control"
                rows="4"
                required
                placeholder="<%= t('skullrax.dashboard.export.placeholder') %>"></textarea>
    </div>

    <div class="form-group form-check mt-2">
      <input type="checkbox" id="export_include_files" name="include_files" value="1" class="form-check-input">
      <label for="export_include_files" class="form-check-label">
        <%= t('skullrax.dashboard.export.include_files') %>
      </label>
    </div>

    <div class="mt-3">
      <a href="#" id="export-link" class="btn btn-primary">
        <%= t('skullrax.dashboard.export.submit') %>
      </a>
    </div>
  </div>
</div>

<%= export_script %>
