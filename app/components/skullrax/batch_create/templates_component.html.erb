<%= render Skullrax::BatchCreate::ResourceItemTemplateComponent.new %>
<%= render Skullrax::BatchCreate::WorkItemTemplateComponent.new %>
<%= render Skullrax::BatchCreate::FileSetItemTemplateComponent.new %>
<%= render Skullrax::BatchCreate::EmptyStateTemplateComponent.new %>

<!-- Hidden form templates for each resource type -->
<div id="form-templates" style="display: none;">
  <% all_resource_types.each do |resource_type| %>
    <div class="form-template" data-resource-type="<%= resource_type %>">
      <% form = form_for_resource_type(resource_type) %>
      <%= simple_form_for form, url: '#', html: { class: 'resource-form-template' } do |form_builder| %>
        <%= render Skullrax::BatchCreate::AdminSetInputComponent.new(work_types:, resource_type:) %>
        <%= render Skullrax::BatchCreate::FormFieldsComponent.new(form:, form_builder:) %>
        <%= render Skullrax::BatchCreate::VisibilityInputComponent.new(resource_type:) %>
        <%= render Skullrax::BatchCreate::FileInputsComponent.new(resource_type:, collection_value:, file_set_value:) %>
      <% end %>
    </div>
  <% end %>
</div>
