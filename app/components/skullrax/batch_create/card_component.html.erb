<div class="card h-100">
  <div class="card-body">
    <h3><%= t('skullrax.dashboard.batch_create.title') %></h3>
    <p class="text-muted"><%= t('skullrax.dashboard.batch_create.instruction') %></p>
    <div id="batch-create-config"
        data-collection-value="<%= collection_value %>"
        data-file-set-value="<%= file_set_value %>"
        style="display: none;">
    </div>
    <%= form_with url: batch_create_path, local: true, multipart: true, id: "batch-create-form" do |f| %>
      <div class="row">
        <div class="col-xl-3 sticky-top" style="top: 4.5rem; max-height: calc(100vh - 5.5rem); overflow-y: auto;">
          <div class="bg-light border rounded p-3 mb-3">
            <h4 class="mb-3"><%= t('skullrax.dashboard.batch_create.resources') %></h4>
            <div id="resources-list">
            </div>
            <div class="form-group">
              <label for="resource-type"><%= t('skullrax.dashboard.batch_create.add_resource') %></label>
              <select id="resource-type" name="resource_type" class="form-control">
                <option value=""><%= t('skullrax.dashboard.batch_create.select_resource_type') %></option>
                <option value="<%= collection_value %>">Collection</option>
                <%= work_options %>
              </select>
            </div>
          </div>

          <div class="my-3">
            <button type="submit" class="btn btn-primary mb-1" id="submit-batch" disabled>
              <%= t('skullrax.dashboard.batch_create.submit') %>
            </button>

            <div class="form-check ml-1 mb-0">
              <input class="form-check-input" type="checkbox" name="autofill" value="true" id="autofill-checkbox">
              <label class="form-check-label" for="autofill-checkbox">
                <%= t('skullrax.dashboard.batch_create.autofill') %>
              </label>
            </div>
            <div class="form-check ml-1 mb-0">
              <input class="form-check-input" type="checkbox" name="download-form-as-csv" value="true" id="download-form-as-csv-checkbox">
              <label class="form-check-label" for="download-form-as-csv-checkbox">
                <%= t('skullrax.dashboard.batch_create.download_form_as_csv') %>
              </label>
            </div>
          </div>
        </div>

        <div class="col-xl-9">
          <div class="border rounded p-4" style="min-height: 400px;" id="forms-container">
            <div class="text-muted text-center py-5">
              <p><%= t('skullrax.dashboard.batch_create.select_to_begin') %></p>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%= render Skullrax::BatchCreate::TemplatesComponent.new %>
