<div class="card h-100">
  <div class="card-body">
    <h3><%= t('skullrax.dashboard.import.title') %></h3>
    <p><%= t('skullrax.dashboard.import.instruction') %></p>
    <%= form_with url: import_path, local: true, multipart: true, scope: :import do |f| %>
      <div class="form-group">
        <small class="form-text text-muted mb-2 d-block">
          <%= t('skullrax.dashboard.import.action_hint') %>
        </small>
        <div class="form-check">
          <%= f.radio_button :action, 'create', checked: true, class: 'form-check-input', id: 'import_action_create' %>
          <%= f.label :action_create, t('skullrax.dashboard.import.action_create'), class: 'form-check-label', for: 'import_action_create' %>
        </div>
        <div class="form-check">
          <%= f.radio_button :action, 'update', class: 'form-check-input', id: 'import_action_update' %>
          <%= f.label :action_update, t('skullrax.dashboard.import.action_update'), class: 'form-check-label', for: 'import_action_update' %>
        </div>
        <div class="form-check">
          <%= f.radio_button :action, 'destroy', class: 'form-check-input', id: 'import_action_destroy' %>
          <%= f.label :action_destroy, t('skullrax.dashboard.import.action_destroy'), class: 'form-check-label', for: 'import_action_destroy' %>
        </div>
      </div>

      <div class="form-group">
        <%= f.label :file, t('skullrax.dashboard.import.label'), class: "sr-only", for: 'import_file' %>
        <%= f.file_field :file, accept: '.csv,.zip', class: 'form-control-file', required: true, id: 'import_file' %>
      </div>

      <div class="mt-3">
        <%= f.submit t('skullrax.dashboard.import.submit'), class: 'btn btn-primary', disabled: true, id: 'import-submit' %>
      </div>
    <% end %>
  </div>
</div>
