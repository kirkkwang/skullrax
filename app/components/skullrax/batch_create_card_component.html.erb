<div class="card h-100">
  <div class="card-body">
    <h3><%= t('skullrax.dashboard.batch_create.title') %></h3>
    <p class="text-muted"><%= t('skullrax.dashboard.batch_create.instruction') %></p>
    <div id="batch-create-config"
        data-collection-value="<%= collection_value %>"
        data-file-set-value="<%= file_set_value %>"
        style="display: none;">
    </div>
    <%= form_with url: batch_create_path, local: true, multipart: true, id: "batch-create-form" do |f| %>
      <div class="row">
        <div class="col-xl-3">
          <div class="bg-light border rounded p-3 mb-3 sticky-top" style="top: 4.5rem; max-height: calc(100vh - 5.5rem); overflow-y: auto;">
            <h4 class="mb-3"><%= t('skullrax.dashboard.batch_create.resources') %></h4>
            <div id="resources-list">
            </div>
            <div class="form-group">
              <label for="resource-type"><%= t('skullrax.dashboard.batch_create.add_resource') %></label>
              <select id="resource-type" name="resource_type" class="form-control">
                <option value=""><%= t('skullrax.dashboard.batch_create.select_resource_type') %></option>
                <option value="<%= collection_value %>"><%= t('hyrax.models.hyrax/pcdm_collection') %></option>
                <%= work_options %>
              </select>
            </div>
          </div>
        </div>

        <div class="col-xl-9">
          <div class="border rounded p-4" style="min-height: 400px;" id="forms-container">
            <div class="text-muted text-center py-5">
              <p><%= t('skullrax.dashboard.batch_create.select_to_begin') %></p>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-3">
        <button type="submit" class="btn btn-primary" id="submit-batch" disabled>
          <%= t('skullrax.dashboard.batch_create.submit') %>
        </button>
      </div>
    <% end %>
  </div>
</div>

<!-- Hidden form templates for each resource type -->
<div id="form-templates" style="display: none;">
  <% all_resource_types.each do |resource_type| %>
    <div class="form-template" data-resource-type="<%= resource_type %>">
      <% form = form_for_resource_type(resource_type) %>
      <%= simple_form_for form, url: '#', html: { class: 'resource-form-template' } do |form_builder| %>
        <div class="base-terms">
          <% form.primary_terms.each do |term| %>
            <%= helpers.render_edit_field_partial(term, f: form_builder, curation_concern: form.model_class) %>
          <% end %>
        </div>
        <% if form.display_additional_fields? %>
          <div class="additional-fields-section mt-3">
            <div class="dropdown">
              <button class="btn btn-secondary dropdown-toggle" type="button" id="secondary-field-selector-RESOURCE_ID" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <%= t('hyrax.works.form.additional_fields') %>
              </button>
              <div class="dropdown-menu secondary-field-selector" aria-labelledby="secondary-field-selector-RESOURCE_ID">
                <!-- Options will be added here by JavaScript -->
              </div>
            </div>
          </div>
          <div class="secondary-terms" style="display: none;">
            <% form.secondary_terms.each do |term| %>
              <div class="secondary-field-wrapper" data-field-name="<%= term %>">
                <%= helpers.render_edit_field_partial(term, f: form_builder, curation_concern: form.model_class) %>
              </div>
            <% end %>
          </div>
        <% end %>

        <!-- Visibility Section -->
        <div class="visibility-section mt-4">
          <h4><%= t('hyrax.base.form_visibility_component.visibility') %></h4>

          <div class="form-check">
            <input class="form-check-input visibility-radio" type="radio" name="resources[RESOURCE_ID][visibility]" value="open" id="visibility-open-RESOURCE_ID" checked data-target="none">
            <label class="form-check-label" for="visibility-open-RESOURCE_ID">
              <%= helpers.visibility_badge(Hydra::AccessControls::AccessRight::VISIBILITY_TEXT_VALUE_PUBLIC) %>
              <small class="form-text text-muted"><%= t('hyrax.visibility.open.note_html', type: resource_type.split('::').last) %></small>
            </label>
          </div>

          <div class="form-check">
            <input class="form-check-input visibility-radio" type="radio" name="resources[RESOURCE_ID][visibility]" value="authenticated" id="visibility-authenticated-RESOURCE_ID" data-target="none">
            <label class="form-check-label" for="visibility-authenticated-RESOURCE_ID">
              <%= helpers.visibility_badge(Hydra::AccessControls::AccessRight::VISIBILITY_TEXT_VALUE_AUTHENTICATED) %>
              <small class="form-text text-muted"><%= t('hyrax.visibility.authenticated.note_html', institution: helpers.institution_name) %></small>
            </label>
          </div>

          <div class="form-check">
            <input class="form-check-input visibility-radio" type="radio" name="resources[RESOURCE_ID][visibility]" value="embargo" id="visibility-embargo-RESOURCE_ID" data-target="embargo-fields-RESOURCE_ID">
            <label class="form-check-label" for="visibility-embargo-RESOURCE_ID">
              <%= helpers.visibility_badge(Hydra::AccessControls::AccessRight::VISIBILITY_TEXT_VALUE_EMBARGO) %>
              <small class="form-text text-muted"><%= t('hyrax.visibility.embargo.note_html') %></small>
            </label>
          </div>

          <div id="embargo-fields-RESOURCE_ID" class="embargo-fields ml-4 mt-2" style="display: none;">
            <div class="form-row">
              <div class="form-group col-md-4">
                <label for="visibility-during-embargo-RESOURCE_ID">Visibility during embargo</label>
                <select class="form-control" name="resources[RESOURCE_ID][visibility_during_embargo]" id="visibility-during-embargo-RESOURCE_ID" disabled>
                  <option value="authenticated">Institution</option>
                  <option value="restricted" selected>Private</option>
                </select>
              </div>
              <div class="form-group col-md-4">
                <label for="embargo-release-date-RESOURCE_ID">Release date</label>
                <input type="date" class="form-control" name="resources[RESOURCE_ID][embargo_release_date]" id="embargo-release-date-RESOURCE_ID" min="<%= Date.tomorrow %>" value="<%= Date.tomorrow %>" disabled>
              </div>
              <div class="form-group col-md-4">
                <label for="visibility-after-embargo-RESOURCE_ID">Visibility after embargo</label>
                <select class="form-control" name="resources[RESOURCE_ID][visibility_after_embargo]" id="visibility-after-embargo-RESOURCE_ID" disabled>
                  <option value="open" selected>Public</option>
                  <option value="authenticated">Institution</option>
                </select>
              </div>
            </div>
          </div>

          <div class="form-check">
            <input class="form-check-input visibility-radio" type="radio" name="resources[RESOURCE_ID][visibility]" value="lease" id="visibility-lease-RESOURCE_ID" data-target="lease-fields-RESOURCE_ID">
            <label class="form-check-label" for="visibility-lease-RESOURCE_ID">
              <%= helpers.visibility_badge(Hydra::AccessControls::AccessRight::VISIBILITY_TEXT_VALUE_LEASE) %>
              <small class="form-text text-muted"><%= t('hyrax.visibility.lease.note_html') %></small>
            </label>
          </div>

          <div id="lease-fields-RESOURCE_ID" class="lease-fields ml-4 mt-2" style="display: none;">
            <div class="form-row">
              <div class="form-group col-md-4">
                <label for="visibility-during-lease-RESOURCE_ID">Visibility during lease</label>
                <select class="form-control" name="resources[RESOURCE_ID][visibility_during_lease]" id="visibility-during-lease-RESOURCE_ID" disabled>
                  <option value="open" selected>Public</option>
                  <option value="authenticated">Institution</option>
                </select>
              </div>
              <div class="form-group col-md-4">
                <label for="lease-expiration-date-RESOURCE_ID">Expiration date</label>
                <input type="date" class="form-control" name="resources[RESOURCE_ID][lease_expiration_date]" id="lease-expiration-date-RESOURCE_ID" min="<%= Date.tomorrow %>" value="<%= Date.tomorrow %>" disabled>
              </div>
              <div class="form-group col-md-4">
                <label for="visibility-after-lease-RESOURCE_ID">Visibility after lease</label>
                <select class="form-control" name="resources[RESOURCE_ID][visibility_after_lease]" id="visibility-after-lease-RESOURCE_ID" disabled>
                  <option value="authenticated" selected>Institution</option>
                  <option value="restricted">Private</option>
                </select>
              </div>
            </div>
          </div>

          <div class="form-check">
            <input class="form-check-input visibility-radio" type="radio" name="resources[RESOURCE_ID][visibility]" value="restricted" id="visibility-restricted-RESOURCE_ID" data-target="none">
            <label class="form-check-label" for="visibility-restricted-RESOURCE_ID">
              <%= helpers.visibility_badge(Hydra::AccessControls::AccessRight::VISIBILITY_TEXT_VALUE_PRIVATE) %>
              <small class="form-text text-muted"><%= t('hyrax.visibility.restricted.note_html') %></small>
            </label>
          </div>
        </div>

        <!-- Add file upload for FileSets (required) -->
        <% if resource_type == file_set_value %>
          <h4 class="mt-4"><%= t('hyrax.works.form.tab.files').singularize %></h4>
          <div class="files-section">
            <div class="form-group">
              <label><%= t('skullrax.dashboard.batch_create.choose_file') %> <span class="text-danger">*</span></label>
              <input type="file" name="resources[RESOURCE_ID][file]" class="form-control-file file-upload-input" required>
              <small class="form-text text-muted"><%= t('skullrax.dashboard.batch_create.file_required_help') %></small>
            </div>
          </div>
        <% end %>

        <!-- Add files section for works (optional, multiple) -->
        <% if resource_type != collection_value && resource_type != file_set_value %>
          <h4 class="mt-4"><%= t('hyrax.works.form.tab.files') %></h4>
          <div class="files-section">
            <div class="form-group">
              <label><%= t('skullrax.dashboard.batch_create.choose_files') %></label>
              <input type="file" name="resources[RESOURCE_ID][files][]" class="form-control-file file-upload-input" multiple>
              <small class="form-text text-muted"><%= t('skullrax.dashboard.batch_create.files_optional_help') %></small>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>

<%= resource_item_template %>
<%= work_item_template %>
<%= fileset_item_template %>
<%= empty_state_template %>
